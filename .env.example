# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROK_API_KEY: xAI Grok API Key for automatic LLM fallback routing
GROK_API_KEY="MY_GROK_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Feature Flag for News Core V3 / V5 (Default false for safety)
VITE_NEWS_CORE_V3_ENABLED="false"
# Server-side Shadow Mode for V2/V3 Read Comparison
NEWS_CORE_V3_SHADOW_MODE="false"
# Legacy News Writer Control (Default true to preserve current behavior)
ATHENA_LEGACY_WRITERS_ENABLED="true"
# Read-Path Canary Controls (Default disabled)
ATHENA_NEWS_CANARY_ENABLED="false"
ATHENA_NEWS_CANARY_PERCENTAGE="0"
SUPABASE_URL="https://guyneushexdlcsmpzjus.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_dpOtsuwUMzhrcqC0X_B0hg_X41eRRCF"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
