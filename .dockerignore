# Node dependencies & logs
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs & local caches
dist
.cache
.vite

# Environment files containing secrets
.env*
!.env.production.example

# Git & repository metadata
.git
.gitignore

# Persistent production data (mounted externally at runtime)
data/

# Temporary test stores & coverage
temp_test_stores
coverage
.vitest

# IDE & OS metadata
.vscode
.idea
.DS_Store
Thumbs.db
