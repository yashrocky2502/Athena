# ==============================================================================
# ATHENA — OFFICIAL PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production or inject these variables in your 
# production container orchestrator (Kubernetes, Docker Compose, Cloud Run).
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Port for Express HTTP server binding (Default: 3000)
PORT=3000

# Application execution environment (Default: production)
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. NEWS CORE V2 INGESTION & SCHEDULER CONTROLS
# ------------------------------------------------------------------------------
# Master control for News Core V2 authoritative news ingestion and RSS sync
# Required: true | Fail State: Fail-Closed (News ingestion & schedulers remain paused)
ATHENA_NEWS_CORE_V2_SYNC_ENABLED=true

# Legacy News Writer Guard (STRICT DEFAULT: false => Prevents legacy store mutation)
ATHENA_LEGACY_WRITERS_ENABLED=false

# ------------------------------------------------------------------------------
# 3. AI PROVIDER CREDENTIALS & MODEL CONFIGURATION
# ------------------------------------------------------------------------------
# Required: Google Gemini API Key for primary/fallback AI intelligence
# Secret: YES | Fail State: Fail-Closed (AI summarization/entity extraction disabled)
GEMINI_API_KEY=your_production_gemini_api_key_here

# Authoritative Gemini primary model (Default: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# Authoritative Gemini fallback model (Default: gemini-3.5-flash)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional: Groq Cloud API Key for ultra-fast primary AI inference
# Secret: YES | Fail State: Fail-Open (Smoothly fails over to GeminiProvider)
GROQ_API_KEY=your_production_groq_api_key_here

# Primary Groq inference model (Default: llama-3.3-70b-versatile)
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile

# Secondary Groq fallback model (Default: llama-3.1-8b-instant)
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 4. GLOBAL NEWS TELEGRAM NOTIFICATION PIPELINE
# ------------------------------------------------------------------------------
# Optional: Telegram Bot Token for global news channel announcements
# Secret: YES | Fail State: Fail-Closed (Global news outbox queue remains paused)
TELEGRAM_BOT_TOKEN=your_production_global_telegram_bot_token_here

# Optional: Telegram Chat/Channel ID for global news broadcasts
# Secret: YES | Fail State: Fail-Closed (Global news outbox queue remains paused)
TELEGRAM_CHAT_ID=your_production_global_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 5. PERSONAL POSITION ALERTS SUBSYSTEM (FROZEN / FAIL-CLOSED DEFAULTS)
# ------------------------------------------------------------------------------
# STRICT SAFETY GUARANTEE: Position Alerts remain DISABLED by default in production.
# Master feature flag for position alerts (STRICT DEFAULT: false)
ATHENA_POSITION_ALERTS_ENABLED=false

# Hard Emergency Kill Switch (STRICT DEFAULT: true => ACTIVE / BLOCKED)
ATHENA_POSITION_ALERTS_KILL_SWITCH=true

# Explicit Human Confirmation Flag (STRICT DEFAULT: false => LIVE OFF)
ATHENA_POSITION_ALERTS_LIVE_CONFIRMED=false

# Optional: Dedicated Telegram Bot Token for personal position alerts
# Secret: YES | Fail State: Fail-Closed (Isolated from global TELEGRAM_BOT_TOKEN)
ATHENA_POSITION_ALERTS_BOT_TOKEN=your_dedicated_position_alert_bot_token_here

# Optional: Dedicated Private Chat ID for personal position alerts
# Secret: YES | Fail State: Fail-Closed (Isolated from global TELEGRAM_CHAT_ID)
ATHENA_POSITION_ALERTS_CHAT_ID=your_dedicated_private_chat_id_here
